---
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  /** Pages like /thanks/ shouldn't be indexed. */
  noindex?: boolean;
  /** Show the in-page section nav (home page only). */
  nav?: boolean;
}

const {
  title = `${site.name}: software engineer`,
  description = site.description,
  noindex = false,
  nav = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const navItems = [
  { label: 'Work', href: '#work' },
  { label: 'Projects', href: '#projects' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
  ...(site.links.cv ? [{ label: 'CV', href: site.links.cv }] : []),
];
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {nav && <link rel="preload" href="/fonts/neon.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="theme-color" content="#141311" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Theme: dark for everyone by default (set on <html> above, so it holds even
        without JS). This runs before first paint and applies a saved choice from the
        toggle, so there's no flash of the wrong theme. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* storage blocked: stay on the default */
        }
        if (saved !== 'light' && saved !== 'dark') saved = null;
        const apply = (t) => {
          root.dataset.theme = t;
          document.getElementById('theme-toggle')?.setAttribute('aria-pressed', t === 'dark');
        };
        apply(saved || 'dark');
        addEventListener('DOMContentLoaded', () => {
          const b = document.getElementById('theme-toggle');
          if (!b) return;
          b.hidden = false;
          apply(root.dataset.theme);
          b.addEventListener('click', () => {
            saved = root.dataset.theme === 'dark' ? 'light' : 'dark';
            apply(saved);
            try {
              localStorage.setItem('theme', saved);
            } catch {
              /* storage blocked: the choice lasts for this page view only */
            }
          });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    {nav && (
      <header class="site-header">
        <nav class="wrap" aria-label="Sections">
          <a class="home" href="#top">
            FC<span class="visually-hidden"> (back to top)</span>
          </a>
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
          {/* Hidden until the theme script runs: without JS it couldn't work. */}
          <button id="theme-toggle" class="theme" type="button" aria-pressed="false" hidden>
            <span class="visually-hidden">Dark mode</span>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </header>
    )}
    <slot name="backdrop" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  ul {
    display: flex;
    gap: var(--s-1);
    margin-left: auto;
    padding: 0;
    list-style: none;
  }

  .theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: calc(var(--s-2) * -1);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .theme[hidden] {
    display: none;
  }

  .theme:hover {
    color: var(--accent);
  }

  .theme svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show what you'll switch to: moon in light mode, sun in dark mode. */
  .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: block;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-2);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .home {
    padding-inline: 0;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  /* Small phones: drop the FC mark so the links and toggle fit. */
  @media (max-width: 400px) {
    .home {
      display: none;
    }
    ul {
      gap: 0;
      margin-left: calc(var(--s-2) * -1);
    }
    a {
      padding-inline: 6px;
    }
  }

  /* Content sits above the backdrop layer (the walking shadow). */
  main {
    position: relative;
    z-index: 1;
  }

  main:focus {
    outline: none;
  }
</style>
