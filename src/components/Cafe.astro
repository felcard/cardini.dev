---
// The wall behind the page: in the bottom-left corner, the shadows of two people
// sunk into low facing sofas in a café, laptops open on the low table between them, a candle in
// the middle in a glass jar. They type; now and then one glances up, stretches, leans in, or sips
// a coffee. At random a waiter brings a coffee, bends down, sets it on the table
// beside one of them and carries on. The candle and the laptop screens are the
// only lights. Shadows are SVG; a small script directs the gestures and waiter.
// Motion switch off or reduced motion: the scene stays, still. No JS: still too.
import Worker from './Worker.astro';
---

<div class="stage" aria-hidden="true">
  <div class="box glow"></div>
  <div class="waiters">
    <template id="waiter">
      <div class="waiter">
        <svg viewBox="0 0 100 220">
          <g class="body">
            <g class="leg leg--back">
              <rect class="w-trousers" x="45" y="126" width="10" height="44" rx="5"></rect>
              <g class="shin">
                <rect class="w-trousers" x="46" y="164" width="8" height="42" rx="4"></rect>
                <path class="w-shoe" d="M45 202 h10 q10 2 11 7 h-21 z"></path>
              </g>
            </g>
            <g class="leg leg--front">
              <rect class="w-trousers" x="45" y="126" width="10" height="44" rx="5"></rect>
              <g class="shin">
                <rect class="w-trousers" x="46" y="164" width="8" height="42" rx="4"></rect>
                <path class="w-shoe" d="M45 202 h10 q10 2 11 7 h-21 z"></path>
              </g>
            </g>
            <!-- long café apron, from the waist -->
            <path class="apron w-apron" d="M38 106 L62 106 L66 172 Q50 175 34 172 Z"></path>
            <!-- everything above the waist bends together when he sets the cup down -->
            <g class="torso">
              <g class="arm arm--back">
                <path class="w-shirt-shade" d="M38 50 h9 l1 56 q-5 9 -10 0 z"></path>
              </g>
              <path class="w-shirt" d="M38 48 Q50 43 62 48 L61 112 L39 112 Z"></path>
              <rect class="w-skin" x="46" y="37" width="8" height="12"></rect>
              <ellipse class="w-skin" cx="50" cy="30" rx="8" ry="9.5"></ellipse>
              <path class="w-skin" d="M57 26 L61.5 32 L57 33.5 Z"></path>
              <path
                class="w-hair"
                d="M42 31 Q41 19 50 19 Q58 19 58.5 25 Q52 23 47 26 Q44 29 43.5 35 Z"
              ></path>
              <!-- carrying arm: a cup and saucer held out at waist height -->
              <g class="carry">
                <path class="w-shirt" d="M53 48 L61 48 L64 84 L56 86 Z"></path>
                <g class="reach">
                  <path class="w-skin" d="M56 82 L62 88 L100 85 L99 79 Z"></path>
                  <path class="w-shirt" d="M56 82 L62 88 L68 87.4 L66 80.6 Z"></path>
                  <g class="carried">
                    <rect class="china" x="92" y="82" width="16" height="2" rx="1"></rect>
                    <path class="china" d="M96 74 L104 74 L103 81 Q100 82.5 97 81 Z"></path>
                    <path
                      class="china"
                      d="M104 75.5 Q107.5 76 106.5 79 Q105.5 80.5 103.5 79.5 L103.6 78.5 Q105.2 79 105.4 78 Q105.8 76.6 104 76.6 Z"
                    ></path>
                  </g>
                </g>
              </g>
            </g>
          </g>
        </svg>
      </div>
    </template>
  </div>

  <div class="box scene">
    <Worker who="her" />
    <Worker who="him" />
    <svg class="furniture" viewBox="0 0 300 220">
      <!-- a big-leafed plant in a pot behind her sofa -->
      <g class="plant">
        <path class="stem" d="M-7 178 C-8 160 -9 140 -6 112"></path>
        <path class="stem" d="M-6 178 C-2 150 6 120 18 96"></path>
        <path class="stem" d="M-8 178 C-12 165 -14 152 -12 140"></path>
        <path class="stem" d="M-5 178 C0 160 4 142 8 128"></path>
        <ellipse
          class="leaf"
          cx="-6"
          cy="108"
          rx="14"
          ry="8.5"
          transform="rotate(-32 -6 108)"
        ></ellipse>
        <ellipse
          class="leaf"
          cx="19"
          cy="93"
          rx="13"
          ry="7.5"
          transform="rotate(24 19 93)"
        ></ellipse>
        <ellipse
          class="leaf"
          cx="-13"
          cy="137"
          rx="11"
          ry="7"
          transform="rotate(-58 -13 137)"
        ></ellipse>
        <ellipse
          class="leaf"
          cx="9"
          cy="124"
          rx="11"
          ry="6.5"
          transform="rotate(38 9 124)"
        ></ellipse>
      </g>
      <path class="pot" d="M-17 176 L3 176 L0 208 L-14 208 Z"></path>
      <!-- low coffee table, short splayed legs -->
      <rect class="tabletop" x="96" y="154" width="108" height="4" rx="1.5"></rect>
      <path class="table-leg" d="M104 158 L108 158 L111 208 L108 208 Z"></path>
      <path class="table-leg" d="M196 158 L192 158 L189 208 L192 208 Z"></path>
      <!-- her laptop: keyboard towards her, lid tilted away -->
      <rect class="alu" x="100" y="152" width="27" height="2" rx="0.5"></rect>
      <path class="alu-dark" d="M125 154 L127.2 154 L132.2 129 L130 128.6 Z"></path>
      <!-- his laptop, mirrored -->
      <rect class="alu" x="173" y="152" width="27" height="2" rx="0.5"></rect>
      <path class="alu-dark" d="M175 154 L172.8 154 L167.8 129 L170 128.6 Z"></path>
      <!-- coffees, shown once the waiter has brought them -->
      <g class="cup cup--her">
        <rect x="132" y="152.5" width="16" height="1.5" rx="0.75"></rect>
        <path d="M136 145 L144 145 L143 152 Q140 153.5 137 152 Z"></path>
      </g>
      <g class="cup cup--him">
        <rect x="152" y="152.5" width="16" height="1.5" rx="0.75"></rect>
        <path d="M156 145 L164 145 L163 152 Q160 153.5 157 152 Z"></path>
      </g>
      <!-- candle in a low glass jar -->
      <rect class="jar" x="143" y="139.5" width="14" height="14.5" rx="1.6"></rect>
      <rect class="jar-rim" x="142.4" y="139" width="15.2" height="1.4" rx="0.7"></rect>
    </svg>
  </div>

  <div class="box lights">
    <svg viewBox="0 0 300 220">
      <!-- laptop screens, glowing at the people -->
      <path class="screen" d="M124.6 152.4 L129.4 129.4"></path>
      <path class="screen" d="M175.4 152.4 L170.6 129.4"></path>
      <!-- the jar's glass, lit from inside above the wax -->
      <rect class="jar-glow" x="143.6" y="140.4" width="12.8" height="7" rx="1.2"></rect>
      <g class="flame">
        <path
          class="outer"
          d="M150 134.5 Q154.6 141.2 152.7 145 Q150 147.5 147.3 145 Q145.4 141.2 150 134.5 Z"
        ></path>
        <path
          class="core"
          d="M150 139.6 Q152.1 143.2 151.2 145.1 Q150 146.3 148.8 145.1 Q147.9 143.2 150 139.6 Z"
        ></path>
      </g>
    </svg>
  </div>
</div>

<script is:inline>
  (() => {
    const stage = document.querySelector('.stage');
    const tpl = document.getElementById('waiter');
    if (!stage || !tpl || !stage.animate) return;
    const crowd = stage.querySelector('.waiters');
    const scene = stage.querySelector('.scene');
    const [her, him] = stage.querySelectorAll('.worker');
    const cups = new Map([
      [her, stage.querySelector('.cup--her')],
      [him, stage.querySelector('.cup--him')],
    ]);
    const hasCoffee = new Set();
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const rand = (a, b) => a + Math.random() * (b - a);
    const pick = (list) => list[Math.floor(Math.random() * list.length)];
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    // The Motion switch is further down the page, so look it up when needed.
    const switchedOn = () => document.getElementById('motion')?.checked !== false;
    const allowed = () => !calm.matches && switchedOn() && !document.hidden;

    // ---- The two at the table ---------------------------------------------
    const lengths = { sip: 3400, focus: 3200, look: 2600, stretch: 3000, nod: 1300 };
    const busy = new Set();
    function act(who, move) {
      if (busy.has(who) || (move === 'sip' && !hasCoffee.has(who))) return;
      busy.add(who);
      who.classList.add(`do-${move}`);
      // While sipping, the cup is in the hand, not on the table.
      if (move === 'sip') cups.get(who).style.opacity = '0';
      setTimeout(() => {
        who.classList.remove(`do-${move}`);
        if (move === 'sip') cups.get(who).style.opacity = '';
        busy.delete(who);
      }, lengths[move]);
    }

    async function work() {
      while (allowed()) {
        await wait(rand(3500, 9000));
        if (!allowed()) break;
        if (Math.random() < 0.15) {
          // They both look up from their screens and catch each other's eye.
          act(her, 'look');
          act(him, 'look');
        } else {
          act(pick([her, him]), pick(['sip', 'sip', 'focus', 'look', 'stretch', 'nod']));
        }
      }
    }

    // ---- The waiter -------------------------------------------------------
    function waiter(facing) {
      const el = tpl.content.firstElementChild.cloneNode(true);
      crowd.append(el);
      const w = el.offsetWidth;
      const speed = el.offsetHeight * rand(0.5, 0.58); // matches the stride
      let x = facing > 0 ? -w - 20 : innerWidth + 20;
      const pose = () => `translateX(${x}px) scaleX(${facing})`;
      el.style.transform = pose();
      return {
        el,
        async walkTo(to) {
          el.classList.remove('standing');
          const from = pose();
          const ms = (Math.abs(to - x) / speed) * 1000;
          x = to;
          el.style.transform = pose();
          await el
            .animate([{ transform: from }, { transform: pose() }], { duration: ms })
            .finished.catch(() => {});
        },
        exit: () => (facing > 0 ? innerWidth + 20 : -w - 20),
      };
    }

    // Scene units (300 × 220): her cup goes at x 140, his at 160. Bent over the
    // low table to set it down, the waiter's hand is at x 102.8 in his own units
    // (facing right), so he stops where that lands on the spot.
    const SPOT = { her: 140, him: 160 };
    const HAND = 102.8;

    async function service() {
      await wait(rand(5000, 10000));
      while (allowed()) {
        // Whoever has no coffee yet gets one; from the right he reaches her side.
        const needs = [her, him].filter((p) => !hasCoffee.has(p));
        const guest = needs.length === 1 ? needs[0] : pick([her, him]);
        const facing = guest === her ? -1 : 1;
        const s = waiter(facing);
        const table = scene.getBoundingClientRect();
        const u = table.height / 220;
        const spot = table.left + (guest === her ? SPOT.her : SPOT.him) * u;
        await s.walkTo(facing < 0 ? spot - (100 - HAND) * u : spot - HAND * u);
        if (s.el.isConnected) {
          s.el.classList.add('standing');
          act(guest, 'look');
          await wait(400);
          s.el.classList.add('placing');
          await wait(1100);
          // Cup down: it's on the table now, not in his hand.
          s.el.classList.add('placed');
          cups.get(guest).classList.add('served');
          hasCoffee.add(guest);
          await wait(500);
          s.el.classList.remove('placing');
          act(guest === her ? him : her, 'nod');
          await wait(900);
        }
        await s.walkTo(s.exit());
        s.el.remove();
        await wait(rand(15000, 35000));
      }
    }

    let running = false;
    async function direct() {
      if (running || !allowed()) return;
      running = true;
      await Promise.all([work(), service()]);
      running = false;
    }

    // Switch off (or reduced motion on): the waiter vanishes, the two sit still.
    const reset = () => {
      if (allowed()) return direct();
      crowd.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      crowd.querySelectorAll('.waiter').forEach((f) => f.remove());
    };
    document.addEventListener('change', (e) => e.target.id === 'motion' && reset());
    calm.addEventListener('change', reset);
    document.addEventListener('visibilitychange', () => allowed() && direct());
    direct();
  })();
</script>

<style>
  .stage {
    --shade: #e7e4df; /* a shadow on the light wall */
    --gap: max(8px, 1.5vw);
    /* free space left of the 680px content column (plus its 24px padding) */
    --margin: calc((100vw - 728px) / 2 + 24px - 2 * var(--gap));
    --sw: clamp(230px, min(var(--margin), 44vh), 420px); /* scene width */
    --sh: calc(var(--sw) * 220 / 300); /* scene height */
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    fill: var(--shade);
  }

  :global([data-theme='dark']) .stage {
    --shade: #0b0a09;
    /* The neon sign lights the wall faintly. */
    background:
      radial-gradient(ellipse 70% 55% at 30% 18%, rgb(47 229 138 / 0.06), transparent 70%),
      radial-gradient(ellipse 50% 45% at 70% 40%, rgb(255 43 214 / 0.04), transparent 70%);
  }

  /* The scene's box: bottom-left corner, 300 × 220 units. */
  .box {
    position: absolute;
    left: var(--gap);
    bottom: 3vh;
    width: var(--sw);
    height: var(--sh);
  }

  .furniture,
  .lights svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Candlelight on the wall, centred on the flame. */
  .glow::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 64%;
    width: 300%;
    height: 280%;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgb(255 205 70 / 0.1), transparent);
  }

  :global([data-theme='dark']) .glow::before {
    background: radial-gradient(
      closest-side,
      rgb(255 205 70 / 0.17),
      rgb(255 180 50 / 0.06) 45%,
      transparent
    );
  }

  .waiters {
    position: absolute;
    inset: 0;
  }

  /* Too narrow for the margin: the scene sits behind the text, so keep it faint. */
  @media (max-width: 1225px) {
    .scene,
    .waiters {
      opacity: 0.22;
    }

    .lights {
      opacity: 0.6;
    }
  }

  /* Dark mode: the same café at night; the candle and screens stay bright
     because they live in the separate .lights layer. */
  :global([data-theme='dark']) .scene,
  :global([data-theme='dark']) .waiters {
    filter: brightness(0.55) saturate(0.85);
  }

  /* ---- Colours: a muted, flat illustration palette ----------------------- */
  .leaf {
    fill: #4f7d4a;
  }

  .pot {
    fill: #b8693f;
  }

  .tabletop {
    fill: #8a5a3a; /* walnut */
  }

  .table-leg {
    fill: #4a3427;
  }

  .alu {
    fill: #b8bcc4;
  }

  .alu-dark {
    fill: #8f959e;
  }

  .cup,
  .china {
    fill: #f4f1ea;
  }

  .jar {
    fill: #eadcc2;
  }

  .jar-rim {
    fill: #cdbb9b;
  }

  .w-shirt {
    fill: #f1efea;
  }

  .w-shirt-shade {
    fill: #dcd8cf;
  }

  .w-apron,
  .w-trousers {
    fill: #2b2724;
  }

  .w-shoe {
    fill: #1c1a19;
  }

  .w-skin {
    fill: #b9805a;
  }

  .w-hair {
    fill: #241a14;
  }

  .stem {
    fill: none;
    stroke: #3f6a3a;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* The plant moves a touch in the air from the door. */
  .plant {
    transform-box: view-box;
    transform-origin: -7px 178px;
    animation: sway-leaves 9s ease-in-out infinite alternate;
  }

  @keyframes sway-leaves {
    to {
      transform: rotate(1.4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plant {
      animation: none;
    }
  }

  :global(html:has(#motion:not(:checked))) .plant {
    animation: none;
  }

  .cup {
    opacity: 0;
    transition: opacity 250ms;
  }

  .cup.served {
    opacity: 1;
  }

  /* ---- Lights: the candle and two laptop screens ---------------------- */
  .screen {
    fill: none;
    stroke: #b9d4ee;
    stroke-width: 1.1;
    stroke-linecap: round;
    filter: drop-shadow(0 0 2px rgb(150 200 255 / 0.5));
  }

  :global([data-theme='dark']) .screen {
    stroke: #d6ecff;
    filter: drop-shadow(0 0 2px #9fd0ff) drop-shadow(0 0 8px rgb(120 180 255 / 0.6));
  }

  .flame {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flicker 2.3s ease-in-out infinite;
    fill: #f0ad00;
    filter: drop-shadow(0 0 3px rgb(255 190 0 / 0.6));
  }

  .core {
    fill: #ffe58a;
  }

  /* The jar glows warm where the flame lights the glass. */
  .jar-glow {
    fill: rgb(255 190 60 / 0.35);
    filter: blur(0.6px);
  }

  :global([data-theme='dark']) .jar-glow {
    fill: rgb(255 196 80 / 0.55);
    filter: blur(0.6px) drop-shadow(0 0 6px rgb(255 170 0 / 0.5));
  }

  :global([data-theme='dark']) .flame {
    fill: #ffd23f;
    filter: drop-shadow(0 0 2px #ffd23f) drop-shadow(0 0 8px #ffb300)
      drop-shadow(0 0 20px rgb(255 170 0 / 0.6));
  }

  :global([data-theme='dark']) .core {
    fill: #fff7cf;
  }

  @keyframes flicker {
    0%,
    100% {
      transform: scale(1, 1) skewX(0deg);
    }
    13% {
      transform: scale(0.96, 1.07) skewX(-3deg);
    }
    29% {
      transform: scale(1.03, 0.94) skewX(2deg);
    }
    41% {
      transform: scale(0.98, 1.04) skewX(-1deg);
    }
    58% {
      transform: scale(1.02, 0.97) skewX(3deg);
    }
    77% {
      transform: scale(0.97, 1.08) skewX(-2deg);
    }
  }

  /* Still flame when motion is off or unwanted. */
  @media (prefers-reduced-motion: reduce) {
    .flame {
      animation: none;
    }
  }

  :global(html:has(#motion:not(:checked))) .flame {
    animation: none;
  }

  /* ---- The waiter ------------------------------------------------------ */
  .waiter {
    position: absolute;
    left: 0;
    bottom: 3vh;
    width: calc(var(--sh) * 100 / 220);
    height: var(--sh);
    transform-origin: center;
  }

  .waiter svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Walk cycle: 1.2 s per two steps. */
  .body,
  .arm,
  .leg,
  .shin,
  .apron,
  .torso,
  .carry,
  .reach,
  .carried {
    transform-box: view-box;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .body {
    animation-name: bob;
    animation-duration: 0.6s;
  }

  .leg {
    transform-origin: 50px 128px;
    animation-name: thigh;
    animation-duration: 1.2s;
  }

  .shin {
    transform-origin: 50px 166px;
    animation-name: knee;
    animation-duration: 1.2s;
  }

  .arm--back {
    transform-origin: 43px 50px;
    animation-name: swing;
    animation-duration: 1.2s;
  }

  .apron {
    transform-origin: 50px 106px;
    animation: sway 0.6s ease-in-out infinite alternate;
  }

  .leg--back,
  .leg--back .shin {
    animation-delay: -0.6s;
  }

  /* Setting the cup down: bend at the waist, reach down, keep the saucer level.
     The angles put his hand on the table top (worked out in scene units). */
  .torso {
    transform-origin: 50px 112px;
    transition: transform 900ms ease-in-out;
  }

  .carry {
    transform-origin: 57px 49px;
    transition: transform 900ms ease-in-out;
  }

  .reach {
    transform-origin: 60px 85px;
    transition: transform 900ms ease-in-out;
  }

  .carried {
    transform-origin: 100px 82px;
    transition:
      transform 900ms ease-in-out,
      opacity 200ms;
  }

  .placing .torso {
    transform: rotate(50deg);
  }

  .placing .carry {
    transform: rotate(-35deg);
  }

  .placing .reach {
    transform: rotate(70deg);
  }

  .placing .carried {
    transform: rotate(-85deg);
  }

  .placed .carried {
    opacity: 0;
  }

  /* At the table: feet together. */
  .standing .body,
  .standing .arm,
  .standing .leg,
  .standing .shin,
  .standing .apron {
    animation: none;
  }

  @keyframes bob {
    50% {
      transform: translateY(-2.5px);
    }
  }

  @keyframes thigh {
    0%,
    100% {
      transform: rotate(-24deg);
    }
    50% {
      transform: rotate(20deg);
    }
  }

  @keyframes knee {
    15% {
      transform: rotate(8deg);
    }
    35% {
      transform: rotate(3deg);
    }
    55% {
      transform: rotate(22deg);
    }
    72% {
      transform: rotate(50deg);
    }
    88% {
      transform: rotate(12deg);
    }
  }

  @keyframes sway {
    from {
      transform: skewX(-2.5deg);
    }
    to {
      transform: skewX(2.5deg);
    }
  }

  @keyframes swing {
    0%,
    100% {
      transform: rotate(-22deg);
    }
    50% {
      transform: rotate(22deg);
    }
  }
</style>
