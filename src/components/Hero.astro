---
import { site } from '../content/site';
import Receipt from './Receipt.astro';

const actions = [
  site.links.cv && { label: 'CV', href: site.links.cv },
  { label: 'GitHub', href: site.links.github },
  site.links.linkedin && { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Contact', href: '#contact' },
].filter((a): a is { label: string; href: string } => Boolean(a));
const [first, ...rest] = site.name.split(' ');
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <h1 id="hero-name">
    {/* Two tubes, like a real sign: the second one has the faulty connection. */}
    <span class="neon">
      {first} <span class="fault">{rest.join(' ')}</span>
    </span>
    <span class="role">{site.role}</span>
  </h1>
  {/* Pause control for the flicker and the café scene (WCAG 2.2.2). Pure CSS. */}
  <label class="switch">
    <input type="checkbox" role="switch" id="motion" checked />
    <span class="track" aria-hidden="true"></span>
    Motion
  </label>
  <p class="lede">{site.hero}</p>
  <ul class="buttons">
    {actions.map((a, i) => (
      <li>
        <a class:list={['button', { 'button--primary': i === 0 }]} href={a.href}>
          {a.label}
        </a>
      </li>
    ))}
  </ul>
  <Receipt />
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--s-6) 0;
  }

  @media (min-width: 600px) {
    .hero {
      padding-top: calc(var(--s-6) * 1.5);
    }
  }

  h1 {
    line-height: 1.05;
  }

  /* ---- Neon sign ----------------------------------------------------
     Light mode: an unlit sign (green tube, faint glow).
     Dark mode: switched on. It flickers once on load, like a sign
     coming on, unless the visitor prefers reduced motion. */
  .neon {
    --tube: var(--accent);
    --glow: rgb(57 229 140 / 0.35);
    display: block;
    font-family: 'Cardini Neon', var(--font);
    font-size: clamp(2.75rem, 9vw + 1rem, 4.75rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    --shadow: 0 0 1px var(--glow), 0 0 14px var(--glow);
    color: var(--tube);
    text-shadow: var(--shadow);
  }

  :global([data-theme='dark']) .neon {
    --tube: #effff5;
    --glow: #2fe58a;
    --shadow:
      0 0 1px #fff, 0 0 4px var(--glow), 0 0 12px var(--glow), 0 0 28px var(--glow),
      0 0 56px rgb(47 229 138 / 0.5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .neon {
      animation: switch-on 1.1s steps(1, end) 0.2s both;
    }
  }

  /* ---- Short circuit (dark mode only) --------------------------------
     Two faults on different, unrelated cycles so the pattern never feels
     regular: the whole sign browns out now and then (11.3 s cycle), and the
     second tube has a bad connection that sputters (7.3 s cycle). Dips are
     partial, as a real tube rarely goes fully dark, and no more than three
     happen in any second (WCAG 2.3.1). The switch pauses both (WCAG 2.2.2). */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-theme='dark']) .neon {
      animation:
        switch-on 1.1s steps(1, end) 0.2s both,
        brownout 11.3s steps(1, end) 1.4s infinite;
    }

    :global([data-theme='dark']) .fault {
      animation: short-circuit 7.3s steps(1, end) 2.1s infinite;
    }
  }

  /* Its own box, so its filter never clips the glow. */
  .fault {
    display: inline-block;
  }

  /* Switch off: keep the (finished) switch-on, drop the faults: steady sign. */
  .hero:has(#motion:not(:checked)) .neon {
    animation-name: switch-on;
  }

  .hero:has(#motion:not(:checked)) .fault {
    animation: none;
  }

  /* Opacity and brightness only, so the faults stack on top of the
     colour/glow switch-on instead of fighting it. */
  @keyframes brownout {
    0%,
    9.6%,
    41.4%,
    74.9%,
    76.6% {
      opacity: 1;
      filter: none;
    }
    9% {
      opacity: 0.6;
      filter: brightness(0.75);
    }
    41% {
      opacity: 0.8;
      filter: brightness(0.9);
    }
    72.4% {
      opacity: 0.45;
      filter: brightness(0.6);
    }
    75.6% {
      opacity: 0.55;
      filter: brightness(0.7);
    }
  }

  @keyframes short-circuit {
    0%,
    23%,
    59.2%,
    64.4% {
      opacity: 1;
      filter: none;
    }
    22.4% {
      opacity: 0.7;
      filter: brightness(0.85);
    }
    58% {
      opacity: 0.2;
      filter: brightness(0.5);
    }
    61.4% {
      opacity: 0.15;
      filter: brightness(0.45);
    }
    63.6% {
      opacity: 0.85;
      filter: brightness(0.95);
    }
  }

  /* The switch only exists where there's motion to stop. */
  .switch {
    display: none;
    position: absolute;
    top: var(--s-2);
    right: 0;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    user-select: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .switch {
      display: inline-flex;
    }
  }

  .switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .track {
    position: relative;
    width: 36px;
    height: 20px;
    border: 1.5px solid var(--muted);
    border-radius: 999px;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .track::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--muted);
    transition:
      translate 150ms ease,
      background-color 150ms ease;
  }

  .switch input:checked + .track {
    border-color: var(--accent);
    box-shadow: 0 0 8px rgb(47 229 138 / 0.45);
  }

  .switch input:checked + .track::after {
    translate: 16px 0;
    background: var(--accent);
  }

  .switch input:focus-visible + .track {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  @keyframes switch-on {
    0%,
    12%,
    26% {
      color: color-mix(in srgb, var(--tube) 35%, var(--bg));
      text-shadow: none;
    }
    8%,
    20%,
    34%,
    100% {
      color: var(--tube);
      text-shadow: var(--shadow);
    }
  }

  /* Second colour, in fuchsia: steady (it never flickers), and it switches on just
     after the green one, like a two-colour shop sign. */
  .role {
    --tube: var(--pink);
    --glow: rgb(255 43 214 / 0.3);
    --shadow: 0 0 1px var(--glow), 0 0 12px var(--glow);
    display: block;
    margin-top: var(--s-2);
    font-family: 'Cardini Neon', var(--font);
    font-size: clamp(1.25rem, 5vw + 0.25rem, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--tube);
    text-shadow: var(--shadow);
  }

  :global([data-theme='dark']) .role {
    --tube: #ffeafb;
    --glow: #ff2bd6;
    --shadow:
      0 0 1px #fff, 0 0 4px var(--glow), 0 0 10px var(--glow), 0 0 24px var(--glow),
      0 0 48px rgb(255 43 214 / 0.45);
  }

  @media (prefers-reduced-motion: no-preference) {
    .role {
      animation: switch-on 0.9s steps(1, end) 0.9s both;
    }
  }

  .lede {
    margin-top: var(--s-4);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .buttons {
    margin-top: var(--s-5);
  }
</style>
