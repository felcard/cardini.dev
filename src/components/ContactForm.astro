---
import { site } from '../content/site';

const key = site.contact.web3formsKey;
const thanksUrl = new URL('/thanks/', Astro.site).href;
---

{key ? (
  <form
    id="contact-form"
    class="form"
    action="https://api.web3forms.com/submit"
    method="POST"
    data-email={site.email}
  >
    {/* Web3Forms config. Without JS the browser posts directly and lands on /thanks/. */}
    <input type="hidden" name="access_key" value={key} />
    <input type="hidden" name="subject" value="New enquiry from cardini.dev" />
    <input type="hidden" name="from_name" value="cardini.dev" />
    <input type="hidden" name="redirect" value={thanksUrl} />
    {/* Honeypot: humans never see it; bots that tick it get dropped by Web3Forms. */}
    <input
      type="checkbox"
      name="botcheck"
      class="honeypot"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        spellcheck="false"
        required
      />
    </div>
    <div class="field">
      <label for="cf-message">Message</label>
      <textarea id="cf-message" name="message" rows="6" required />
    </div>

    <button class="button button--primary" type="submit">
      Send message
    </button>

    <div class="status" role="status" aria-live="polite">
      <p class="msg msg--ok" hidden>
        Thanks, your message has been sent. I'll get back to you soon.
      </p>
      <p class="msg msg--error" hidden>
        Sorry, your message didn't send. Please email me instead at{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </form>
) : null}

<p class="fallback">
  {key ? 'Or email ' : 'Email '}
  <a href={`mailto:${site.email}`}>{site.email}</a>
</p>

{key && <script is:inline>
  // Progressive enhancement: send in place and show the result inline.
  // Without JS the form still posts normally and redirects to /thanks/.
  (() => {
    const f = document.getElementById('contact-form');
    if (!f || !window.fetch) return;
    const btn = f.querySelector('button');
    const ok = f.querySelector('.msg--ok');
    const err = f.querySelector('.msg--error');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      ok.hidden = err.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const data = Object.fromEntries(new FormData(f));
        delete data.redirect;
        const r = await fetch(f.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const j = await r.json();
        if (!r.ok || !j.success) throw new Error(j.message);
        f.reset();
        ok.hidden = false;
      } catch {
        err.hidden = false;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send message';
      }
    });
  })();
</script>}

<style>
  .form {
    display: grid;
    gap: var(--s-4);
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }

  label {
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    min-height: 44px;
    padding: var(--s-2) 12px;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 2px solid var(--muted);
    border-radius: 6px;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 0;
    border-color: var(--text);
  }

  .honeypot {
    display: none;
  }

  button {
    justify-self: start;
    font-size: var(--step-0);
    padding-inline: var(--s-4);
  }

  .msg {
    padding: var(--s-3);
    border-left: 4px solid var(--accent);
    background: var(--surface);
  }

  .msg--error {
    border-left-color: #c0392b;
  }

  .fallback {
    margin-top: var(--s-4);
  }
</style>
