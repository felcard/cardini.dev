---
// One developer sunk into a low café sofa (seen from the side), facing right,
// leaning over a laptop on the low table. "him" is drawn on the same skeleton and
// mirrored, but dressed differently: she has loose shoulder-length hair, glasses, a big knit
// sweater and crossed legs; he has a hoodie and a baseball cap. Flat, muted colours.
// Idle: bursty typing, breathing, small head movements while reading.
// Gestures are one-shot `do-*` classes added by the Cafe director: sip (once the
// waiter has brought a coffee), focus, look, stretch, nod.
// Skeleton (scene units): hip pivot (44,160), shoulder (65,111), elbow (82,138),
// hands on the keyboard (116,152), neck (66,98). The sip angles were solved on it.
interface Props {
  who: 'her' | 'him';
}
const { who } = Astro.props;
const her = who === 'her';
---

<svg class:list={['worker', `worker--${who}`]} viewBox="0 0 130 220" aria-hidden="true">
  <!-- low modular sofa in teal velvet: deep seat cushion, slouchy back cushion, a pillow -->
  <path class="sofa" d="M4 205 L4 171 Q4 160 15 160 L79 160 Q90 160 90 171 L90 205 Z"></path>
  <path class="seam" d="M8 174 C30 176 62 176 87 174"></path>
  <path
    class="sofa-back"
    d="M6 168 C0 146 2 124 10 114 C15 108 22 109 26 115 C31 126 30 146 29 164 Z"
  ></path>
  <path
    class="pillow"
    d="M19 140 C21 132 31 131 35 137 C38 144 36 153 29 155 C23 156 18 148 19 140 Z"
  ></path>
  <rect class="wood" x="8" y="204" width="5" height="4" rx="1"></rect>
  <rect class="wood" x="80" y="204" width="5" height="4" rx="1"></rect>

  {her ? (
    <>
      {/* legs crossed: far leg to the floor, near leg over it, foot dangling */}
      <path
        class="bottoms-shade"
        d="M36 152 C52 148 70 144 84 142 L90 153 C72 157 56 162 40 165 Z"
      />
      <path class="bottoms-shade" d="M82 145 C86 144 91 144 93 146 L96 205 L86 205 Z" />
      <path class="shoe" d="M85 202 L103 203.5 Q107 205 106 208 Q105 209.5 102 209.5 L85 209.5 Z" />
      <path
        class="bottoms"
        d="M38 147 C55 141 72 135 87 133 C93 133 95 141 91 146 C74 148 56 153 40 157 Z"
      />
      <path class="bottoms" d="M86 139 C88 136 92 135 95 137 L107 171 C106 174 102 176 99 174 Z" />
      <path
        class="shoe"
        d="M99 171 C102 168 107 169 110 172 L115 177 Q115 180 112 180 L102 178 Q98 176 99 171 Z"
      />
    </>
  ) : (
    <>
      {/* legs apart, relaxed, feet flat */}
      <path
        class="bottoms"
        d="M36 150 C52 146 70 142 85 141 C91 142 93 150 90 154 C72 157 56 162 40 165 Z"
      />
      <path class="bottoms" d="M83 145 C87 143 92 144 94 147 L99 205 L88 205 Z" />
      <path class="shoe" d="M87 202 L106 203.5 Q110 205 109 208 Q108 209.5 105 209.5 L87 209.5 Z" />
    </>
  )}

  <g class="upper">
    <g class="breath">
      {/* torso: a slouched back curving up into soft shoulders */}
      <path
        class="top"
        d="M30 165 C30 145 35 125 45 112 C51 104 57 100 62 99 L71 101 C77 106 79 114 77 123 C74 137 67 151 63 165 Z"
      ></path>
      {/* ribbed hem (her knit) or hoodie hem (him) */}
      <path class="top-shade" d="M30.5 157 L65 157 L63 165 L30 165 Z"></path>
      {her ? (
        <path
          class="skin"
          d="M61.2 103.6 C64.4 102.6 68.6 102.6 72.4 103.4 L74 95.4 L73.8 88 L64 87.4 L62.8 95.2 Z"
        />
      ) : (
        <path class="skin" d="M60 101 L70 102 L73 93 L63 92 Z" />
      )}
      {!her && (
        /* hood, lying flat on his shoulders */
        <path
          class="top-shade"
          d="M46 110 C45.5 104 50 99.5 56.5 99.5 C60.5 100 61.5 102.5 60 105 C56 107.5 51 109.5 46 110 Z"
        />
      )}
      <!-- head tipped down: eyes on the screen -->
      <g transform="rotate(12 66 98)">
        <g class="head">
          <!-- profile: skull, brow, nose, lips, chin; then ear, eye and eyebrow -->
          {her ? (
            /* finer profile: smaller nose, defined chin, jaw rising cleanly to the ear */
            <path
              class="skin"
              d="M59.5 90 C55.5 83 56.5 74 63 69.5 C69.5 65.5 78 67.5 81 73.5 L81.8 77.5 L85 83 L82.3 84.2 L82.4 86.4 L81 87.6 L81.4 89.4 C80.8 91.3 79.5 92.4 77.7 92.6 C75.4 92.8 73.1 92.1 71.1 90.5 C68.4 88.8 63.9 89.5 59.5 90 Z"
            />
          ) : (
            <>
              <path
                class="skin"
                d="M59.5 92 C55.5 84 56.5 74 63 69.5 C69.5 65.5 78 67.5 81 73.5 L81.8 77.5 L85.6 83.6 L82.4 84.8 L82.6 87 L81 88.2 L81.6 90.2 C80 93.2 76 95.2 71.8 95.2 C67.6 95.6 62.6 95 59.5 92 Z"
              />
              <ellipse class="skin-shade" cx="66" cy="81.5" rx="2.4" ry="3.3" />
            </>
          )}
          <circle class="ink" cx="78" cy="78.6" r="0.8"></circle>
          <path
            class="hair"
            d="M75 75.4 C76.5 74.6 78.6 74.6 80.2 75.4 L80 76.1 C78.6 75.6 76.8 75.6 75.2 76.2 Z"
          ></path>
          {her ? (
            <>
              {/* loose hair: framing the face from the temple to the jaw, over the ear, down past the shoulders */}
              <path
                class="hair"
                d="M80.5 72 C78 66 71 62.5 64 64 C57 65.5 53.5 72 53.5 80 C53.5 88 52 95 50.5 101 C49.5 106 50.5 111 53.5 114 C56 116.5 59.5 115.5 61 112.5 C62 108 61.6 103 61.8 99 C62.2 95.4 65 92.2 68.6 90.4 C70.8 87 71.6 82 72.6 78.6 C73.6 75.6 74.8 74 76.4 73.2 C77.8 72.6 79.2 72.4 80.5 72 Z"
              />
              {/* a soft wave of lighter strands down the back */}
              <path
                class="hair-light"
                d="M56.5 76 C55.5 84 55 92 53.5 100 C52.8 104 53.3 108 55.2 110.5 C54.8 106 55.8 101 57 95 C58 89 58.2 82 56.5 76 Z"
              />
              {/* glasses: lens and frame clear the face line */}
              <path
                class="lens"
                d="M76 76.6 C78.5 76 82.8 76.4 83.4 78.6 C83.6 80.8 81.6 81.8 79.6 81.6 C77.4 81.4 75.8 80.2 76 76.6 Z"
              />
              <rect class="frame" x="66.5" y="77.6" width="10" height="1" rx="0.5" />
            </>
          ) : (
            <>
              {/* a little hair showing below the cap at the back */}
              <path class="hair" d="M58.5 82 C57.8 86 58.8 89 60.5 90.5 C60 87 60.2 84 61.2 81 Z" />
              {/* baseball cap: rounded crown, top button, brim pointing forward */}
              <path
                class="cap"
                d="M57.5 82 C55 70 61 62 69.5 61.5 C77 61 82 66 82.5 72.5 L82.5 74 C74 73.5 65 76 57.5 82 Z"
              />
              <circle class="cap-shade" cx="69.5" cy="61.2" r="1.3" />
              <path
                class="cap-shade"
                d="M79 72 C84 71.5 89 72.5 92.5 74.6 C92 75.8 90 76 87 75.8 C84 75.6 81 75.4 79 75.6 Z"
              />
            </>
          )}
        </g>
      </g>
      <!-- arm: shoulder (65,111) → elbow (82,138) → hands on the keyboard (116,152) -->
      <g class="arm">
        <path
          class="top"
          d="M59 112 C62 107 70 106 73 111 L88 134 C88 139 83 143 78 141 L62 118 Z"
        ></path>
        <g class="forearm">
          <path
            class="top"
            d="M79 133.5 C88 136.5 100 141 111 145.6 L109.6 152.6 C100 149.6 90 146 78 142 C75.5 140 76 135 79 133.5 Z"
          ></path>
          <path class="top-shade" d="M105 143.4 L111 145.6 L109.6 152.6 L103.6 150.6 Z"></path>
          <path
            class="skin"
            d="M110 146 C114 145.6 119 147 120.8 149.8 C121.4 152.8 119 155.2 116 155 C113 154.6 110.4 153 109.6 151.6 Z"
          ></path>
          <!-- the coffee cup, only in hand while sipping -->
          <g class="held-cup">
            <path class="cup" d="M112 141 L120 141 L119 148 Q116 149.5 113 148 Z"></path>
            <path
              class="cup"
              d="M112 142.5 Q108.5 143 109.5 146 Q110.5 147.5 112.5 146.5 L112.4 145.5 Q110.8 146 110.6 145 Q110.2 143.6 112 143.6 Z"
            ></path>
          </g>
        </g>
      </g>
    </g>
  </g>
</svg>

<style>
  .worker {
    position: absolute;
    top: 0;
    height: 100%;
    width: calc(130 / 300 * 100%);
    overflow: visible;
  }

  .worker--her {
    left: 0;
  }

  /* The other person: same skeleton, mirrored, across the table. */
  .worker--him {
    right: 0;
    transform: scaleX(-1);
  }

  /* ---- Colours: a muted, flat illustration palette ----------------------- */
  .worker {
    --skin: #e2b593;
    --skin-shade: #c9946f;
    --hair: #3a271c;
    --top: #e8d8bc; /* oat knit sweater */
    --top-shade: #d2bd98;
    --bottoms: #3b4a63; /* dark jeans */
    --bottoms-shade: #2f3c51;
    --shoe: #f1efe9;
    --ink: #2a2420;
  }

  .worker--him {
    --skin: #b98059;
    --skin-shade: #9c6644;
    --hair: #1f1712;
    --top: #66724a; /* olive hoodie */
    --top-shade: #555f3b;
    --bottoms: #3b3b40; /* charcoal joggers */
    --cap: #2e3c5c;
    --cap-shade: #243049;
  }

  .sofa {
    fill: #3f6f6a;
  }

  .sofa-back {
    fill: #4b7f78;
  }

  .seam {
    fill: none;
    stroke: #335b57;
    stroke-width: 1;
  }

  .pillow {
    fill: #c8693f;
  }

  .wood {
    fill: #4a3427;
  }

  .skin {
    fill: var(--skin);
  }

  .skin-shade {
    fill: var(--skin-shade);
  }

  .hair {
    fill: var(--hair);
  }

  .hair-light {
    fill: #5a3e2c;
  }

  .ink {
    fill: var(--ink);
  }

  .top {
    fill: var(--top);
  }

  .top-shade {
    fill: var(--top-shade);
  }

  .bottoms {
    fill: var(--bottoms);
  }

  .bottoms-shade {
    fill: var(--bottoms-shade);
  }

  .shoe {
    fill: var(--shoe);
  }

  .cap {
    fill: var(--cap);
  }

  .cap-shade {
    fill: var(--cap-shade);
  }

  .lens {
    fill: rgb(220 235 245 / 0.35);
    stroke: var(--ink);
    stroke-width: 0.9;
  }

  .frame {
    fill: var(--ink);
  }

  .cup {
    fill: #f4f1ea;
  }

  .upper,
  .breath,
  .head,
  .arm,
  .forearm,
  .held-cup {
    transform-box: view-box;
    animation-timing-function: ease-in-out;
  }

  .upper {
    transform-origin: 44px 160px;
  }

  .breath {
    transform-origin: 44px 160px;
    animation: breathe 4.4s ease-in-out infinite alternate;
  }

  .worker--him .breath {
    animation-duration: 5.1s;
  }

  .head {
    transform-origin: 66px 98px;
    /* Small, slow head movements while reading. */
    animation: read 7s ease-in-out infinite;
  }

  /* His own, slower rhythm. */
  .worker--him .head {
    animation-duration: 8.6s;
    animation-delay: -3s;
  }

  .arm {
    transform-origin: 65px 111px;
  }

  .forearm {
    transform-origin: 82px 138px;
    /* Typing in bursts: runs of taps, a pause to read, a reach for the trackpad. */
    animation: type 2.6s linear infinite;
  }

  .worker--him .forearm {
    animation-duration: 3.4s;
    animation-delay: -1.2s;
  }

  .held-cup {
    transform-origin: 116px 152px;
    opacity: 0;
  }

  /* Still when motion is off or unwanted. */
  @media (prefers-reduced-motion: reduce) {
    .breath,
    .head,
    .forearm {
      animation: none !important;
    }
  }

  :global(html:has(#motion:not(:checked))) .breath,
  :global(html:has(#motion:not(:checked))) .head,
  :global(html:has(#motion:not(:checked))) .forearm {
    animation: none !important;
  }

  @keyframes breathe {
    to {
      transform: rotate(-0.9deg) scaleY(1.008);
    }
  }

  @keyframes read {
    0%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(1.5deg);
    }
    55% {
      transform: rotate(-1deg);
    }
    80% {
      transform: rotate(2deg);
    }
  }

  @keyframes type {
    0%,
    4.9%,
    9%,
    13.9%,
    18%,
    22.9%,
    27%,
    48%,
    52.9%,
    57%,
    61.9%,
    66%,
    82%,
    95%,
    100% {
      transform: rotate(0deg);
    }
    5%,
    8.9% {
      transform: rotate(-1.7deg);
    }
    14%,
    17.9% {
      transform: rotate(-1.2deg);
    }
    23%,
    26.9% {
      transform: rotate(-1.9deg);
    }
    49%,
    52.8% {
      transform: rotate(-1.4deg);
    }
    58%,
    61.8% {
      transform: rotate(-1.8deg);
    }
    /* a slow reach to the trackpad and back */
    86%,
    91% {
      transform: rotate(3deg);
    }
  }

  /* ---- Gestures (one-shot; the director removes the class afterwards) ---- */
  .do-sip .arm {
    animation: sip-arm 3.4s ease-in-out;
  }

  .do-sip .forearm {
    animation: sip-forearm 3.4s ease-in-out !important;
  }

  .do-sip .held-cup {
    opacity: 1;
    animation: level 3.4s ease-in-out;
  }

  .do-sip .head {
    animation: tip-back 3.4s ease-in-out !important;
  }

  .do-focus .upper {
    animation: lean-in 3.2s ease-in-out;
  }

  .do-look .head {
    animation: look-up 2.6s ease-in-out !important;
  }

  .do-stretch .upper {
    animation: lean-back 3s ease-in-out;
  }

  .do-stretch .arm {
    animation: arms-up 3s ease-in-out;
  }

  .do-stretch .forearm {
    animation: none !important;
  }

  .do-nod .head {
    animation: nod 1.3s ease-in-out !important;
  }

  /* Elbow up, cup rim to the lips (solved so it stops at the mouth, not past it),
     cup kept nearly upright, tipped 15deg to drink. */
  @keyframes sip-arm {
    30%,
    68% {
      transform: rotate(-20deg);
    }
  }

  @keyframes sip-forearm {
    30%,
    68% {
      transform: rotate(-93deg);
    }
  }

  @keyframes level {
    30%,
    68% {
      transform: rotate(98deg);
    }
  }

  @keyframes tip-back {
    35%,
    65% {
      transform: rotate(-14deg);
    }
  }

  @keyframes lean-in {
    25%,
    80% {
      transform: rotate(5deg);
    }
  }

  @keyframes look-up {
    20%,
    75% {
      transform: rotate(-18deg);
    }
  }

  @keyframes lean-back {
    25%,
    75% {
      transform: rotate(-14deg);
    }
  }

  @keyframes arms-up {
    25%,
    75% {
      transform: rotate(-25deg);
    }
  }

  @keyframes nod {
    25%,
    75% {
      transform: rotate(8deg);
    }
    50% {
      transform: rotate(0deg);
    }
  }
</style>
